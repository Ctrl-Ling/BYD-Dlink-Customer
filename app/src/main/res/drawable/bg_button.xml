<?xml version="1.0" encoding="utf-8"?>
<!-- The face every tappable value and button in this screen is drawn with: a card carries no
     borders of its own, so a clickable number otherwise reads as a label. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/colorButtonFace" />
    <stroke
        android:width="1dp"
        android:color="@color/colorButtonStroke" />
    <corners android:radius="6dp" />
</shape>
